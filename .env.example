# API-owned infrastructure settings. Do not expose these in web or mobile builds.
ConnectionStrings__SurplusLink=Host=localhost;Port=5432;Database=surpluslink;Username=postgres;Password=change-me
Jwt__Issuer=SurplusLink.Api
Jwt__Audience=SurplusLink.Clients
Jwt__Secret=replace-with-a-random-secret-at-least-32-characters
Jwt__ExpirationMinutes=60
Cors__AllowedOrigins__0=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5170
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_SHARED_TOKEN=replace-with-a-local-development-secret
# Opt in after starting the internal FastAPI service. Never expose these to clients.
AgentWorkflow__Enabled=false
AgentWorkflow__PollSeconds=2
AgentWorkflow__TimeoutSeconds=60
AgentWorkflow__HttpTimeoutSeconds=30
AgentWorkflow__MaxRetries=1
AgentWorkflow__MaxCandidates=10
WORKFLOW_STAGE_TIMEOUT_SECONDS=5
WORKFLOW_TIMEOUT_SECONDS=25
WORKFLOW_TOOL_TIMEOUT_SECONDS=1
WORKFLOW_MAX_RETRIES=1
WORKFLOW_TRANSACTION_THRESHOLD=100000
