# API-owned infrastructure settings. Do not expose these in web or mobile builds.
ConnectionStrings__SurplusLink=Host=localhost;Port=5432;Database=surpluslink;Username=postgres;Password=change-me
Jwt__Issuer=SurplusLink.Api
Jwt__Audience=SurplusLink.Clients
Jwt__Secret=replace-with-a-random-secret-at-least-32-characters
Jwt__ExpirationMinutes=60
# Backend-only Gmail SMTP. Use a Google App Password; never put this in web/mobile variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=SurplusLink
Cors__AllowedOrigins__0=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5170
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_SHARED_TOKEN=replace-with-a-local-development-secret
# Copy this routing block to ignored .env.local for scripts/start-local.ps1.
# Set real credentials and your own tariffs; values below are examples only.
# Server-side OpenRouteService only. Flutter and React never receive these values.
Routing__Provider=OpenRouteService
Routing__Endpoint=https://api.openrouteservice.org/v2/directions/driving-car/json
Routing__ApiKey=replace-with-your-openrouteservice-key
Routing__TimeoutSeconds=10
Routing__BaseFee=100
Routing__CostPerKm=50
Routing__CostPerMinute=2
# Execution is enabled by default. Both services must share the token. Never expose it to clients.
AgentWorkflow__Enabled=true
AgentWorkflow__PollSeconds=2
AgentWorkflow__TimeoutSeconds=60
AgentWorkflow__HttpTimeoutSeconds=30
AgentWorkflow__MaxRetries=1
AgentWorkflow__MaxCandidates=10
WORKFLOW_STAGE_TIMEOUT_SECONDS=5
WORKFLOW_TIMEOUT_SECONDS=25
WORKFLOW_TOOL_TIMEOUT_SECONDS=1
WORKFLOW_MAX_RETRIES=1
WORKFLOW_TRANSACTION_THRESHOLD=100000
