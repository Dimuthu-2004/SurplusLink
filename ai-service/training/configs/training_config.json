{
  "model_version": "surpluslink-semantic-v1",
  "base_model": "qwen/qwen3.8-27b",
  "fine_tune_provider": "groq",
  "hyperparameters": {
    "n_epochs": 3,
    "batch_size": 16,
    "learning_rate_multiplier": 1.0,
    "temperature": 0.0,
    "max_tokens": 1000
  },
  "eval_thresholds": {
    "min_schema_valid_rate": 0.95,
    "min_intent_accuracy": 0.90,
    "min_intent_macro_f1": 0.88,
    "min_slot_f1": 0.85,
    "min_follow_up_accuracy": 0.88,
    "min_topic_switch_accuracy": 0.88
  },
  "deployment_rules": {
    "require_state_machine_validation": true,
    "require_unit_normalizer": true,
    "require_validation_gate": true,
    "allow_direct_db_queries": false,
    "allow_price_memorization": false
  }
}
